{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eventflow/detection.v1.json",
  "title": "detection payload, schema_version 1",
  "description": "One tracked object detection. bbox = [x, y, width, height], normalized to 0..1 of the frame.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tracker_run_id", "track_id", "class", "confidence", "bbox"],
  "properties": {
    "tracker_run_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "track_id": { "type": "integer", "minimum": 0 },
    "class": { "type": "string", "minLength": 1, "maxLength": 64 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "bbox": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
