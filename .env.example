# Copy to .env (never commit .env). Values here are for local development only.

# PostgreSQL
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow-dev
POSTGRES_DB=eventflow
POSTGRES_PORT=5432

# Ingest service
INGEST_PORT=8080
# Comma-separated source_id:token pairs. Each agent token may write only as its own source_id.
INGEST_AGENT_TOKENS=edge-01:dev-token-edge-01
